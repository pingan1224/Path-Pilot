Thumbs.db

# Ingestion cache. Raw HTML is a regenerable local cache and mostly boilerplate, so it
# stays out of the repo. The manifest (provenance: url, sha256, fetched_at) and the
# extracted text snapshot DO get committed — the eval labels reference that corpus, so
# reproducibility depends on it being versioned rather than re-scraped.
api/data/raw/pages/
api/data/raw/sitemap.xml

# Chunks are deterministic from the committed sections plus ingest/chunk.py, and one
# strategy file per arm runs to ~1.6MB. Regenerate with `python -m ingest.chunk --compare`.
api/data/chunks/

# Logs
*.log
npm-debug.log*

# Scratch renders and working files
tmp/
