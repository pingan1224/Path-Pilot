# Copy to .env and fill in. Never commit .env.

# Postgres connection string (Neon, Supabase, or local).
# Must be a database with the pgvector extension available.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# Origins allowed to call this API. Comma-separated.
# In production this is the web origin, and it has to be exact — the session cookie is
# SameSite=lax, so anything that is not same-origin with the browser will not carry it.
CORS_ORIGINS=http://localhost:5173

# One OpenAI key serves everything since 2026-08-14: the conversation, embeddings, and the
# vision endpoint that reads a photographed transcript (app/intake/ocr.py, which discloses
# to the student that the image leaves the machine before they choose to upload one).
# Without a key the assistant reports itself unavailable rather than the API failing to boot.
OPENAI_API_KEY=

# Both model names default in app/config.py, which is the only place they are written
# down. Set them here only to override for a local comparison — an out-of-date name here
# beats the default silently, and the request fails as a model_not_found 404 that the
# agent reports as a generic technical problem.
# CHAT_MODEL=gpt-5.4-mini
# EMBEDDING_MODEL=text-embedding-3-small
#
# gpt-5-family models take a reasoning-effort knob. Unset means the parameter is not sent,
# which is what keeps a non-reasoning CHAT_MODEL (the gpt-4.1 line) working unchanged.
# CHAT_REASONING_EFFORT=medium

# Signs the session cookie. The default in app/config.py exists so local development runs
# without setup, and it is deliberately obvious. DEPLOYMENT MUST OVERRIDE IT: a predictable
# signing key means anyone can mint a session for any user.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Adds the Secure flag to the session cookie. Must be true anywhere served over HTTPS;
# false locally, because a Secure cookie is not sent over http and login would silently
# fail to stick.
SESSION_HTTPS_ONLY=false

# Password for the seeded demo accounts. Public by design — the point of /demo is that a
# reader can walk in — but read from the environment so a deployed instance can rotate it
# without a code change. Matches the value the demo page prints.
DEMO_PASSWORD=path-pilot-demo-2026

# Which chunking strategy retrieval reads, and how it ranks. Every chunking arm is embedded
# and stored at once, so an ablation is this setting plus a re-run of the eval.
# CHUNK_STRATEGY=heading
# RETRIEVAL_MODE=vector

# Arms scripts/fault_probe.py, which breaks embeddings / the chat model / a tool on
# purpose to watch the degraded paths run. MUST stay unset anywhere real: with it off,
# no fault can be armed at all.
# FAULT_INJECTION=true
